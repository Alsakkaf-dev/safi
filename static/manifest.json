{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Safi",
  "description": "__MSG_extDesc__",
  "version": "0.1.0",
  "default_locale": "ar",
  "author": "Mohammed Alsakkaf",
  "homepage_url": "https://github.com/Alsakkaf-dev/safi",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "__MSG_extName__" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["https://raw.githubusercontent.com/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_scripts": [
    {
      "matches": ["*://*.google.com/search*", "*://*.google.com.sa/search*", "*://*.google.ae/search*", "*://*.google.com.eg/search*", "*://*.google.com.my/search*", "*://*.google.co.uk/search*", "*://*.google.de/search*", "*://*.google.fr/search*", "*://*.google.com.kw/search*", "*://*.google.com.qa/search*", "*://*.google.jo/search*", "*://*.google.co.ma/search*", "*://*.google.dz/search*", "*://*.google.iq/search*", "*://*.google.com.om/search*", "*://*.google.com.bh/search*", "*://*.google.com.ly/search*", "*://*.google.tn/search*", "*://*.google.com.lb/search*", "*://*.google.ps/search*", "*://*.google.com.tr/search*", "*://*.google.ca/search*", "*://*.google.com.au/search*", "*://*.google.co.in/search*", "*://*.bing.com/search*", "*://duckduckgo.com/*", "*://html.duckduckgo.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
